    "rag_qa": {
      "name": "RAG知识库问答",
      "description": "检索知识库后生成回答",
      "type": "workflow",
      "nodes": [
        "start",
        "knowledge-retrieval",
        "llm",
        "end"
      ],
      "template": {
        "version": "0.5.0",
        "kind": "app",
        "dependencies": [],
        "app": {
          "mode": "workflow",
          "name": "知识库问答"
        },
        "workflow": {
          "graph": {
            "nodes": [
              {
                "id": "start_1",
                "data": {
                  "type": "start",
                  "title": "开始",
                  "variables": [
                    {
                      "label": "问题",
                      "variable": "query",
                      "type": "paragraph",
                      "required": true
                    }
                  ]
                }
              },
              {
                "id": "kr_1",
                "data": {
                  "type": "knowledge-retrieval",
                  "title": "知识检索",
                  "query_variable_selector": [
                    "start_1",
                    "query"
                  ],
                  "dataset_ids": [
                    "__DATASET_ID__"
                  ],
                  "retrieval_mode": "multiple",
                  "multiple_retrieval_config": {
                    "top_k": 5,
                    "score_threshold": 0.5
                  }
                }
              },
              {
                "id": "llm_1",
                "data": {
                  "type": "llm",
                  "title": "生成回答",
                  "model": {
                    "provider": "langgenius/moonshot/moonshot",
                    "name": "kimi-k2-turbo-preview",
                    "mode": "chat",
                    "completion_params": {
                      "temperature": 0
                    }
                  },
                  "prompt_template": [
                    {
                      "role": "system",
                      "text": "基于以下参考资料回答用户问题。如果资料中没有相关信息，请如实告知。\n\n参考资料：\n{{#kr_1.context#}}",
                      "id": "llm_1_system_0"
                    },
                    {
                      "role": "user",
                      "text": "{{#start_1.query#}}",
                      "id": "llm_1_user_1"
                    }
                  ],
                  "context": {
                    "enabled": true,
                    "variable_selector": [
                      "kr_1",
                      "result"
                    ]
                  },
                  "memory": {
                    "enabled": false,
                    "role_prefix": {
                      "assistant": "",
                      "user": ""
                    },
                    "window": {
                      "enabled": false,
                      "size": 10
                    }
                  },
                  "vision": {
                    "enabled": false,
                    "configs": {
                      "variable_selector": []
                    }
                  }
                }
              },
              {
                "id": "end_1",
                "data": {
                  "type": "end",
                  "title": "结束",
                  "outputs": [
                    {
                      "variable": "answer",
                      "value_selector": [
                        "llm_1",
                        "text"
                      ]
                    }
                  ]
                }
              }
            ],
            "edges": [
              {
                "source": "start_1",
                "target": "kr_1"
              },
              {
                "source": "kr_1",
                "target": "llm_1"
              },
              {
                "source": "llm_1",
                "target": "end_1"
              }
            ]
          }
        }
      }
    },
