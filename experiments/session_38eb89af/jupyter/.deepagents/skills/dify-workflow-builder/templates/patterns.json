    "batch_iteration": {
      "name": "批量迭代处理",
      "description": "对数组数据逐项处理",
      "type": "workflow",
      "nodes": [
        "start",
        "parameter-extractor",
        "iteration",
        "template",
        "end"
      ],
      "template": {
        "version": "0.5.0",
        "kind": "app",
        "dependencies": [],
        "app": {
          "mode": "workflow",
          "name": "批量处理"
        },
        "workflow": {
          "graph": {
            "nodes": [
              {
                "id": "start_1",
                "data": {
                  "type": "start",
                  "variables": [
                    {
                      "label": "待处理内容",
                      "variable": "content",
                      "type": "paragraph",
                      "required": true
                    }
                  ]
                }
              },
              {
                "id": "extractor_1",
                "data": {
                  "type": "parameter-extractor",
                  "title": "提取列表",
                  "query": [
                    "start_1",
                    "content"
                  ],
                  "model": {
                    "provider": "langgenius/moonshot/moonshot",
                    "name": "kimi-k2-turbo-preview",
                    "mode": "chat",
                    "completion_params": {
                      "temperature": 0
                    }
                  },
                  "parameters": [
                    {
                      "name": "items",
                      "type": "array[string]",
                      "description": "待处理的条目列表",
                      "required": true
                    }
                  ],
                  "instruction": "从输入中提取所有需要处理的条目"
                }
              },
              {
                "id": "iteration_1",
                "data": {
                  "type": "iteration",
                  "title": "逐项处理",
                  "iterator_selector": [
                    "extractor_1",
                    "items"
                  ],
                  "output_selector": [
                    "iter_llm_1",
                    "text"
                  ],
                  "is_parallel": true,
                  "parallel_nums": 5,
                  "error_handle_mode": "continue-on-error",
                  "start_node_id": "iteration_1start",
                  "flatten_output": true
                }
              },
              {
                "id": "iteration_1start",
                "type": "custom-iteration-start",
                "parentId": "iteration_1",
                "data": {
                  "type": "iteration-start",
                  "title": "",
                  "desc": "",
                  "isInIteration": true
                }
              },
              {
                "id": "iter_llm_1",
                "type": "custom",
                "parentId": "iteration_1",
                "data": {
                  "type": "llm",
                  "title": "逐项处理(Llm)",
                  "desc": "",
                  "isInIteration": true,
                  "iteration_id": "iteration_1",
                  "model": {
                    "provider": "langgenius/moonshot/moonshot",
                    "name": "kimi-k2-turbo-preview",
                    "mode": "chat",
                    "completion_params": {
                      "temperature": 0
                    }
                  },
                  "prompt_template": [
                    {
                      "role": "system",
                      "text": "你是一个有帮助的助手。",
                      "id": "iter_llm_1_system_0"
                    },
                    {
                      "role": "user",
                      "text": "{{#iteration_1.item#}}",
                      "id": "iter_llm_1_user_1"
                    }
                  ],
                  "context": {
                    "enabled": false,
                    "variable_selector": []
                  },
                  "memory": {
                    "enabled": false,
                    "window": {
                      "enabled": false,
                      "size": 10
                    }
                  },
                  "vision": {
                    "enabled": false,
                    "configs": {
                      "variable_selector": []
                    }
                  }
                }
              },
              {
                "id": "template_1",
                "data": {
                  "type": "template-transform",
                  "title": "格式化输出",
                  "template": "处理结果：\n{% for item in results %}\n- {{ item }}\n{% endfor %}",
                  "variables": [
                    {
                      "variable": "results",
                      "value_selector": [
                        "iteration_1",
                        "output"
                      ],
                      "value_type": "array[string]"
                    }
                  ]
                }
              },
              {
                "id": "end_1",
                "data": {
                  "type": "end",
                  "outputs": [
                    {
                      "variable": "result",
                      "value_selector": [
                        "template_1",
                        "output"
                      ]
                    }
                  ]
                }
              }
            ],
            "edges": [
              {
                "source": "start_1",
                "target": "extractor_1"
              },
              {
                "source": "extractor_1",
                "target": "iteration_1"
              },
              {
                "source": "iteration_1start",
                "target": "iter_llm_1"
              },
              {
                "source": "iteration_1",
                "target": "template_1"
              },
              {
                "source": "template_1",
                "target": "end_1"
              }
            ]
          }
        }
      }
    },
